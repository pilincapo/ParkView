{
  "entities": {
    "Establishment": {
      "title": "Establishment",
      "description": "Represents a parking lot establishment.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "ownerId": { "type": "string" },
        "members": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "settings": { "$ref": "Setting" }
      },
      "required": ["name", "ownerId", "members", "settings"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Represents a vehicle in the parking lot or its history.",
      "type": "object",
      "properties": {
        "establishmentId": { "type": "string" },
        "plate": {
          "type": "string",
          "description": "License plate of the vehicle."
        },
        "slotId": {
          "type": "string",
          "description": "Identifier of the assigned parking slot."
        },
        "vehicleType": {
          "type": "string",
          "enum": ["car", "motorcycle"],
          "description": "Type of vehicle."
        },
        "entryType": {
          "type": "string",
          "enum": ["daily", "monthly"],
          "description": "Type of entry (daily or monthly pass)."
        },
        "entryTime": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of entry."
        },
        "exitTime": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of exit (null if currently parked)."
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed"],
          "description": "Status of the parking session."
        },
        "totalAmount": {
          "type": "number",
          "description": "Calculated cost of the stay."
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the staff member who registered the vehicle."
        }
      },
      "required": ["plate", "slotId", "vehicleType", "entryType", "entryTime", "status", "ownerId", "establishmentId"]
    },
    "MonthlyPass": {
      "title": "MonthlyPass",
      "description": "Represents a monthly parking subscription for a specific license plate.",
      "type": "object",
      "properties": {
        "establishmentId": { "type": "string" },
        "plate": {
          "type": "string",
          "description": "License plate associated with the pass."
        },
        "vehicleType": {
          "type": "string",
          "enum": ["car", "motorcycle"],
          "description": "Type of vehicle."
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Subscription start date."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "Subscription end date."
        },
        "amount": {
          "type": "number",
          "description": "Amount paid for the subscription."
        },
        "status": {
          "type": "string",
          "enum": ["active", "expired"],
          "description": "Current status of the subscription."
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the staff member who created the subscription."
        }
      },
      "required": ["plate", "vehicleType", "startDate", "endDate", "amount", "status", "ownerId", "establishmentId"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global parking configuration.",
      "type": "object",
      "properties": {
        "hourlyRate": {
          "type": "number",
          "description": "Price per hour or fraction of hour for cars."
        },
        "motoHourlyRate": {
          "type": "number",
          "description": "Price per hour or fraction of hour for motorcycles."
        },
        "monthlyRate": {
          "type": "number",
          "description": "Standard monthly rate for cars."
        },
        "motoMonthlyRate": {
          "type": "number",
          "description": "Standard monthly rate for motorcycles."
        },
        "carSlots": {
          "type": "number",
          "description": "Number of slots for cars."
        },
        "motoSlots": {
          "type": "number",
          "description": "Number of slots for motorcycles."
        },
        "totalSlots": {
          "type": "number",
          "description": "Total number of slots (legacy)."
        },
        "updatedBy": {
          "type": "string",
          "description": "UID of the staff member who last updated settings."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last update."
        }
      },
      "required": ["hourlyRate", "motoHourlyRate", "carSlots", "motoSlots", "totalSlots", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/establishments": {
      "schema": "Establishment",
      "description": "Collection of all parking establishments."
    },
    "/vehicles": {
      "schema": "Vehicle",
      "description": "Collection of all parking sessions scoped by establishment."
    },
    "/monthlyPasses": {
      "schema": "MonthlyPass",
      "description": "Collection of monthly subscriptions scoped by establishment."
    }
  }
}
