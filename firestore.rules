rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.get('email_verified', false) == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidVehicle(data) {
      return data.keys().hasAll(['plate', 'slotId', 'vehicleType', 'entryTime', 'status', 'ownerId']) &&
             data.plate is string &&
             data.slotId is string &&
             data.vehicleType in ['car', 'motorcycle'] &&
             data.status in ['active', 'completed'] &&
             data.ownerId is string &&
             (data.keys().hasAny(['entryTime']) ? data.entryTime is timestamp : true) &&
             (data.keys().hasAny(['exitTime']) ? data.exitTime is timestamp || data.exitTime == null : true) &&
             (data.keys().hasAny(['totalAmount']) ? data.totalAmount is number : true);
    }

    function isValidMonthlyPass(data) {
      return data.keys().hasAll(['plate', 'vehicleType', 'startDate', 'endDate', 'amount', 'status', 'ownerId']) &&
             data.keys().size() == 7 &&
             data.plate is string && data.plate.size() >= 1 && data.plate.size() <= 20 &&
             data.vehicleType in ['car', 'motorcycle'] &&
             data.startDate is timestamp &&
             data.endDate is timestamp &&
             data.amount is number &&
             data.status in ['active', 'expired'] &&
             data.ownerId is string && data.ownerId.size() >= 1;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['hourlyRate', 'motoHourlyRate', 'carSlots', 'motoSlots', 'totalSlots', 'updatedBy', 'updatedAt', 'monthlyRate', 'motoMonthlyRate']) &&
             data.keys().size() == 9 &&
             data.hourlyRate is number && data.hourlyRate >= 0 &&
             data.motoHourlyRate is number && data.motoHourlyRate >= 0 &&
             data.monthlyRate is number && data.monthlyRate >= 0 &&
             data.motoMonthlyRate is number && data.motoMonthlyRate >= 0 &&
             data.carSlots is number && data.carSlots >= 1 && data.carSlots <= 500 &&
             data.motoSlots is number && data.motoSlots >= 1 && data.motoSlots <= 500 &&
             data.totalSlots is number && data.totalSlots >= 1 &&
             data.updatedBy is string &&
             (data.updatedAt is timestamp || data.updatedAt == request.time);
    }

    // --- Rules ---

    match /vehicles/{vehicleId} {
      allow get: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isVerified() && 
                    isValidId(vehicleId) && 
                    isValidVehicle(incoming()) &&
                    incoming().ownerId == request.auth.uid &&
                    incoming().status == 'active' &&
                    incoming().entryTime == request.time;
      
      allow update: if isVerified() &&
                    isValidId(vehicleId) &&
                    existing().ownerId == request.auth.uid &&
                    incoming().ownerId == existing().ownerId &&
                    (
                      // Action: Complete Stay
                      (existing().status == 'active' && incoming().status == 'completed' &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'exitTime', 'totalAmount'])) ||
                      // Action: Correction
                      (incoming().status == existing().status &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['plate', 'slotId']))
                    );

      allow delete: if false; 
    }

    match /monthlyPasses/{passId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(passId) && isValidMonthlyPass(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isVerified() && isValidId(passId) && isValidMonthlyPass(incoming()) && 
                    existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isVerified() && existing().ownerId == request.auth.uid;
    }

    match /settings/parking {
      allow get: if isSignedIn();
      allow write: if isVerified() && (
        !exists(/databases/$(database)/documents/settings/parking) || 
        (isValidSetting(incoming()) && incoming().updatedBy == request.auth.uid)
      );
    }
  }
}
