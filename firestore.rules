rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidVehicle(data) {
      return data.keys().hasAll(['plate', 'entryTime', 'status', 'ownerId']) &&
             data.keys().size() >= 4 &&
             data.plate is string && data.plate.size() >= 1 && data.plate.size() <= 20 &&
             data.entryTime is timestamp &&
             data.status in ['active', 'completed'] &&
             data.ownerId == request.auth.uid &&
             (data.keys().hasAny(['slotId']) ? data.slotId is string && data.slotId.size() >= 1 && data.slotId.size() <= 20 : true) &&
             (data.keys().hasAny(['exitTime']) ? data.exitTime is timestamp || data.exitTime == null : true) &&
             (data.keys().hasAny(['totalAmount']) ? data.totalAmount is number : true);
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['hourlyRate', 'totalSlots', 'updatedBy', 'updatedAt']) &&
             data.keys().size() == 4 &&
             data.hourlyRate is number && data.hourlyRate >= 0 &&
             data.totalSlots is number && data.totalSlots >= 1 && data.totalSlots <= 500 &&
             data.updatedBy == request.auth.uid &&
             (data.updatedAt is timestamp || data.updatedAt == request.time);
    }

    // --- Rules ---

    match /vehicles/{vehicleId} {
      allow get: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isVerified() && 
                    isValidId(vehicleId) && 
                    isValidVehicle(incoming()) &&
                    incoming().keys().hasAll(['slotId', 'exitTime', 'totalAmount']) &&
                    incoming().entryTime == request.time &&
                    incoming().status == 'active';
      
      allow update: if isVerified() &&
                    isValidVehicle(incoming()) &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().entryTime == existing().entryTime &&
                    (
                      // Action: Complete Stay
                      (existing().status == 'active' && incoming().status == 'completed' &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'exitTime', 'totalAmount']) &&
                       (incoming().exitTime == request.time || incoming().exitTime is timestamp) &&
                       incoming().totalAmount >= 0) ||
                      // Action: Correction (Status stays same)
                      (incoming().status == existing().status &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['plate', 'slotId']))
                    );

      allow delete: if false; // Audit logs should persist
    }

    match /settings/parking {
      allow get: if isSignedIn();
      allow write: if isVerified() && isValidSetting(incoming());
    }
  }
}
