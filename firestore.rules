rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.get('email_verified', false) == true
      );
    }

    function isMember(establishmentId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/establishments/$(establishmentId)) &&
             get(/databases/$(database)/documents/establishments/$(establishmentId)).data.members.hasAny([request.auth.uid]);
    }

    function isEstablishmentOwner(establishmentId) {
      return isSignedIn() && 
             get(/databases/$(database)/documents/establishments/$(establishmentId)).data.ownerId == request.auth.uid;
    }

    function isSuperAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'pilin123@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidEstablishment(data) {
      return data.keys().hasAll(['name', 'ownerId', 'members', 'settings']) &&
             data.name is string && data.name.size() > 0 &&
             data.ownerId is string &&
             data.members is list &&
             isValidSetting(data.settings);
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['plate', 'slotId', 'vehicleType', 'entryTime', 'status', 'ownerId', 'establishmentId']) &&
             data.plate is string &&
             data.slotId is string &&
             data.vehicleType in ['car', 'motorcycle'] &&
             data.status in ['active', 'completed'] &&
             data.ownerId is string &&
             data.establishmentId is string &&
             (data.keys().hasAny(['entryTime']) ? data.entryTime is timestamp : true) &&
             (data.keys().hasAny(['exitTime']) ? data.exitTime is timestamp || data.exitTime == null : true) &&
             (data.keys().hasAny(['totalAmount']) ? data.totalAmount is number : true);
    }

    function isValidMonthlyPass(data) {
      return data.keys().hasAll(['plate', 'vehicleType', 'startDate', 'endDate', 'amount', 'status', 'ownerId', 'establishmentId']) &&
             data.plate is string &&
             data.vehicleType in ['car', 'motorcycle'] &&
             data.startDate is timestamp &&
             data.endDate is timestamp &&
             data.amount is number &&
             data.status in ['active', 'expired'] &&
             data.ownerId is string &&
             data.establishmentId is string;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['hourlyRate', 'motoHourlyRate', 'carSlots', 'motoSlots', 'totalSlots', 'updatedBy', 'monthlyRate', 'motoMonthlyRate']) &&
             data.hourlyRate is number &&
             data.motoHourlyRate is number &&
             data.monthlyRate is number &&
             data.motoMonthlyRate is number &&
             data.carSlots is number &&
             data.motoSlots is number &&
             data.totalSlots is number &&
             data.updatedBy is string;
    }

    // --- Rules ---

    match /establishments/{establishmentId} {
      allow get: if isSignedIn() && (resource.data.members.hasAny([request.auth.uid]) || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.members.hasAny([request.auth.uid]) || isSuperAdmin());
      allow create: if isVerified() && isSuperAdmin() && isValidEstablishment(incoming());
      allow update: if isVerified() && (isEstablishmentOwner(establishmentId) || isSuperAdmin()) && isValidEstablishment(incoming());
      allow delete: if isVerified() && isSuperAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manual via console for security
    }

    match /vehicles/{vehicleId} {
      allow get: if isMember(existing().establishmentId);
      allow list: if isSignedIn() && isMember(resource.data.establishmentId);
      
      allow create: if isVerified() && 
                    isValidId(vehicleId) && 
                    isValidVehicle(incoming()) &&
                    isMember(incoming().establishmentId) &&
                    incoming().ownerId == request.auth.uid &&
                    incoming().status == 'active';
      
      allow update: if isVerified() &&
                    isValidId(vehicleId) &&
                    isMember(existing().establishmentId) &&
                    incoming().establishmentId == existing().establishmentId &&
                    incoming().ownerId == existing().ownerId &&
                    (
                      // Action: Complete Stay
                      (existing().status == 'active' && incoming().status == 'completed' &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'exitTime', 'totalAmount'])) ||
                      // Action: Correction
                      (incoming().status == existing().status &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['plate', 'slotId']))
                    );

      allow delete: if false; 
    }

    match /monthlyPasses/{passId} {
      allow get, list: if isSignedIn() && isMember(resource.data.establishmentId);
      allow create: if isVerified() && isValidId(passId) && isValidMonthlyPass(incoming()) && 
                    isMember(incoming().establishmentId) &&
                    incoming().ownerId == request.auth.uid;
      allow update: if isVerified() && isValidId(passId) && isValidMonthlyPass(incoming()) && 
                    isMember(existing().establishmentId) && 
                    incoming().ownerId == existing().ownerId;
      allow delete: if isVerified() && isMember(existing().establishmentId);
    }

    match /settings/parking {
      allow get: if isSignedIn();
      allow write: if isVerified() && (
        !exists(/databases/$(database)/documents/settings/parking) || 
        (isValidSetting(incoming()) && incoming().updatedBy == request.auth.uid)
      );
    }
  }
}
